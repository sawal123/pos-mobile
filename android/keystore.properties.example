# Copy this file to android/keystore.properties and fill in the real values.
#
# android/keystore.properties is git-ignored and must never be committed.
# Use only forward slashes; storeFile is resolved against the Android root.
#
# Store credentials may also be supplied through environment variables, which
# take priority: POS_RELEASE_STORE_FILE, POS_RELEASE_STORE_PASSWORD,
# POS_RELEASE_KEY_ALIAS, POS_RELEASE_KEY_PASSWORD.

storeFile=signing/pos-mobile-release.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
